{
  "manifest_version": 3,
  "name": "PagePilot - AI for Safari",
  "short_name": "PagePilot",
  "version": "0.16.1",
  "description": "A private, on-demand webpage AI assistant powered by your own OpenAI-compatible API key (DeepSeek by default).",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://api.openai.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "PagePilot — Ask about this page",
    "default_icon": {
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
